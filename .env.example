# Application
APP_NAME=Tiku RAG
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:5173
SESSION_COOKIE_SECURE=false
SETTINGS_ENCRYPTION_KEY=replace-with-a-fernet-key
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-to-a-long-password

# Database
# Format: postgresql+psycopg://username:url-encoded-password@host:port/database_name
DATABASE_URL=postgresql+psycopg://username:password@db.example.com:5432/tiku_rag

# Runtime configuration
# Storage, retrieval, models, OCR, chunk defaults, and upload limits can be
# changed by a super administrator in the application after login. The values
# below are initial defaults until the admin UI saves an override.

# Object storage
STORAGE_PROVIDER=minio
DATA_DIR=./data
MINIO_ENDPOINT=minio.example.com:9000
MINIO_ACCESS_KEY=replace-me
MINIO_SECRET_KEY=replace-me
MINIO_BUCKET=tiku-rag
MINIO_SECURE=false

# Retrieval
VECTOR_PROVIDER=milvus
MILVUS_URI=http://milvus.example.com:19530
MILVUS_TOKEN=
MILVUS_COLLECTION=tiku_document_chunks
CHUNK_SIZE=800
CHUNK_OVERLAP=120
EMBEDDING_BASE_URL=http://embedding.example.com/v1
EMBEDDING_API_KEY=replace-me
EMBEDDING_MODEL=your-embedding-model
EMBEDDING_BATCH_SIZE=8
EMBEDDING_TIMEOUT_SECONDS=120

# Answer generation
# Leave these empty to return the highest-ranked source chunk directly.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TEMPERATURE=0.1

# OCR for scanned PDFs
OCR_PROVIDER=none
OCR_BASE_URL=
OCR_API_KEY=
OCR_MODEL=

# Upload limits
MAX_UPLOAD_MB=50
